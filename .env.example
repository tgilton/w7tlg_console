# Copy this file to .env and fill in your actual values.
# .env is gitignored — never commit real secrets.

ANTHROPIC_API_KEY=sk-ant-...

# Manual callsign lookup (spot/seek) — HamQTH and/or QRZ XML API accounts.
# Both optional; the lookup tool tries whichever credentials are present.
HAMQTH_USERNAME=
HAMQTH_PASSWORD=
QRZ_USERNAME=
QRZ_PASSWORD=
