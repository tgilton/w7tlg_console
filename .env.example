# Copy this file to .env and fill in your actual values.
# .env is gitignored — never commit real secrets.

ANTHROPIC_API_KEY=sk-ant-...

# Manual callsign lookup (spot/seek) — HamQTH and/or QRZ XML API accounts.
# Both optional; the lookup tool tries whichever credentials are present.
HAMQTH_USERNAME=
HAMQTH_PASSWORD=
QRZ_USERNAME=
QRZ_PASSWORD=

# --- Fast PTT monitor (optional; both default to the values shown) ---
# The fast PTT monitor silences the SDR audio the instant you key up. With
# it off, muting falls back to the console's 100ms poll — later, not absent.
# Nothing safety-related uses it: the amp band-select, antenna and drive-limit
# guards all run off a separate check. Turn it off only to test whether its
# request rate is what upsets the rig link. Restart the console after editing.
FAST_PTT_MONITOR=on
# How often it asks the radio whether you are transmitting, in milliseconds.
# Raising this lowers the load on the rig link. Anything unparseable or
# outside 1-1000 falls back to 5.
FAST_PTT_POLL_MS=5
